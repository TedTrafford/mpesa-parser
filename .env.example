# .env.example — copy to .env and fill in your values.
# The .env file is git-ignored. Never commit real credentials.
#
# Load with: export $(cat .env | xargs)
# Or use python-dotenv in your scripts.

# ── MySQL connection ──────────────────────────────────────────────────────────
MPESA_DB_HOST=127.0.0.1
MPESA_DB_PORT=3306
MPESA_DB_NAME=Data_Science
MPESA_DB_USER=staging
MPESA_DB_PASSWORD=your_password_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the country code prepended when normalising local mobile numbers.
# Default: 254 (Kenya)
# MOBILE_COUNTRY_CODE=254
