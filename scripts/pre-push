#!/usr/bin/env bash
# scripts/pre-push
# -----------------------------------------------------------------------
# Git pre-push hook — runs lint + tests before every push.
#
# Install:
#   make hooks          (copies this file to .git/hooks/pre-push)
#   chmod +x .git/hooks/pre-push   (done automatically by `make hooks`)
#
# To bypass in an emergency:
#   git push --no-verify
# -----------------------------------------------------------------------

set -e

echo ""
echo "========================================="
echo "  pre-push: running local checks..."
echo "========================================="

# Detect project root (works whether the hook lives in .git/hooks/ or scripts/)
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Use the venv python if available, then active conda/system python, then python3
if [ -f "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON="$REPO_ROOT/.venv/bin/python"
elif [ -f "$REPO_ROOT/venv/bin/python" ]; then
    PYTHON="$REPO_ROOT/venv/bin/python"
else
    PYTHON="$(which python 2>/dev/null || which python3)"
fi

# ── 1. lint ───────────────────────────────────────────────────────────────────
echo ""
echo "[1/2] Linting..."
$PYTHON -m flake8 config.py parser/ db/ parse_single.py process_all_pdfs.py \
    --count \
    --select=E9,F63,F7,F82,F4 \
    --show-source \
    --statistics

$PYTHON -m flake8 config.py parser/ db/ parse_single.py process_all_pdfs.py \
    --count \
    --max-line-length=120 \
    --extend-ignore=E203,E221,E272,E302,E303,E305,E402,E501,W291,W292,W293,W503 \
    --statistics

echo "  Lint passed."

# ── 2. tests ──────────────────────────────────────────────────────────────────
echo ""
echo "[2/2] Running tests..."
$PYTHON -m pytest tests/ -v --tb=short

echo ""
echo "========================================="
echo "  pre-push: all checks passed — pushing."
echo "========================================="
echo ""
